{
  "appId": "com.supercoin.vault",
  "appName": "SuperCoin Vault",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#000000"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
